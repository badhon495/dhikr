    <string name="onboarding_welcome_title">Dhikr</string>
    <string name="onboarding_welcome_body">সহজে যিকর গণনা করুন। একটি শান্ত, ব্যক্তিগত কাউন্টার — কোনো অ্যাকাউন্ট নেই, বিজ্ঞাপন নেই, কিছুই ট্র্যাক করা হয় না।</string>
    <string name="onboarding_tap_title">গণনা করতে ট্যাপ করুন</string>
    <string name="onboarding_tap_body">কাউন্টার স্ক্রিনে যেকোনো জায়গায় ট্যাপ করুন। গণনা সাথে সাথে হালনাগাদ হয়, নিশ্চিত করতে একটি মৃদু কম্পন সহ।</string>
    <string name="onboarding_laps_title">ল্যাপ ও লক্ষ্য</string>
    <string name="onboarding_laps_body">একটি ল্যাপ লক্ষ্য ঠিক করুন, অ্যাপ আপনার জন্য ল্যাপ গণনা করবে। দৈনিক ও রুটিন লক্ষ্য আপনার অগ্রগতি দেখায়।</string>
    <string name="onboarding_history_title">কিছুই হারায় না</string>
    <string name="onboarding_history_body">প্রতিটি সেশন স্বয়ংক্রিয়ভাবে সংরক্ষিত হয়। যেকোনো সময়, এমনকি অফলাইনেও আপনার ইতিহাস ও মোট দেখুন।</string>
    <string name="onboarding_privacy_title">নকশাগতভাবে ব্যক্তিগত</string>
    <string name="onboarding_privacy_body">সবকিছু আপনার ডিভাইসেই থাকে। অ্যাপটি সম্পূর্ণ অফলাইনে কাজ করে এবং কখনো আপনার যিকর কোথাও পাঠায় না।</string>

    <string name="onboarding_welcome_title">Dhikr</string>
    <string name="onboarding_welcome_body">Count Dhikr, simply. A calm, private counter — no account, no ads, nothing tracked.</string>
    <string name="onboarding_tap_title">Tap to count</string>
    <string name="onboarding_tap_body">Tap anywhere on the counter screen. The count updates instantly, with a soft vibration to confirm.</string>
    <string name="onboarding_laps_title">Laps and goals</string>
    <string name="onboarding_laps_body">Set a lap target and the app tracks laps for you. Daily and routine goals show your progress as you go.</string>
    <string name="onboarding_history_title">Nothing is lost</string>
    <string name="onboarding_history_body">Every session is saved automatically. Revisit your history and totals any time, even offline.</string>
    <string name="onboarding_privacy_title">Private by design</string>
    <string name="onboarding_privacy_body">Everything stays on your device. The app works fully offline and never sends your Dhikr anywhere.</string>
